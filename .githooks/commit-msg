#!/usr/bin/env bash
# Conventional Commits gate, run locally by git before the commit object
# is created. Enable once per clone with:
#   git config core.hooksPath .githooks
set -euo pipefail

MSG_FILE="$1"
FIRST_LINE=$(head -n1 "$MSG_FILE")

PATTERN='^(feat|fix|chore|docs|refactor|test|ci)(\([a-z0-9_-]+\))?(!)?: .+'

if [[ "$FIRST_LINE" =~ ^Merge ]]; then
  exit 0  # don't block merge commits
fi

if ! [[ "$FIRST_LINE" =~ $PATTERN ]]; then
  echo "ERROR: commit message does not follow Conventional Commits." >&2
  echo "  got:      $FIRST_LINE" >&2
  echo "  expected: <type>(<scope>): <description>" >&2
  echo "  types:    feat fix chore docs refactor test ci" >&2
  echo "" >&2
  echo "See .gitmessage for the full cheat sheet, or bypass once with:" >&2
  echo "  git commit --no-verify" >&2
  exit 1
fi
